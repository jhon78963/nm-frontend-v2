{
  "name": "nm-frontend-v2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "./deploy/build-production.sh",
    "build:staging": "ng build --configuration=staging",
    "pre-cutover": "./deploy/pre-cutover-check.sh",
    "cutover:t0": "./deploy/cutover-t0.sh",
    "archive:legacy": "./deploy/archive-legacy-backup.sh",
    "rollback:legacy": "./deploy/rollback-to-legacy.sh",
    "post-cutover": "./deploy/post-cutover-check.sh",
    "deploy": "ng build --configuration production",
    "smoke:routes": "./deploy/smoke-routes.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.12",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
